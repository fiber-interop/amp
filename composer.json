{
    "name": "fiber-interop/amp",
    "description": "Native AMPHP v3 adapter for fiber-interop/api: go() returns an Amp\\Future; await, sleep, readable, writable on Amp and Revolt.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "fiber-interop/api": "^0.2",
        "fiber-interop/scope": "^0.2",
        "amphp/amp": "^3.0",
        "revolt/event-loop": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11"
    },
    "autoload": {
        "psr-4": {
            "FiberInterop\\Amp\\": "src/"
        },
        "files": [
            "src/register.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "FiberInterop\\Amp\\Tests\\": "tests/"
        }
    }
}
