{
    "name": "fiber-interop/amp",
    "description": "Native AMPHP v3 adapter for fiber-interop/api: go() returns an Amp\\Future; await, sleep, readable, writable on Amp and Revolt.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "fiber-interop/api": "*",
        "amphp/amp": "^3.0",
        "revolt/event-loop": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11",
        "fiber-interop/scope": "*"
    },
    "repositories": [
        { "type": "path", "url": "../api" },
        { "type": "path", "url": "../scope" }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": { "FiberInterop\\Amp\\": "src/" },
        "files": ["src/register.php"]
    },
    "autoload-dev": {
        "psr-4": { "FiberInterop\\Amp\\Tests\\": "tests/" }
    }
}
